# Anula el "Require all denied" del .htaccess de la raíz del proyecto
Require all granted

RewriteEngine On

# Pasa la cabecera Authorization a PHP (algunos hosting FastCGI la eliminan).
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
