      "name": "Enviar cambio de estado",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "notes": "Si el pedido aún no existe, el back-office lo guarda como pendiente de sincronización (202).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Validar contrato').item.json;\nconst r = $input.item.json;\nlet outcome, error_code = null, message = null, result = null;\n\nif (r.prepared === false) {                       // falló antes de llegar al back-office\n  outcome = r.outcome; error_code = r.error_code; message = r.message;\n} else if (r.statusCode === undefined) {          // sin respuesta: red caída, timeout...\n  outcome = 'error'; error_code = 'backoffice_unreachable';\n  message = String((r.error && (r.error.message || r.error)) || 'Sin respuesta del back-office');\n} else if (r.statusCode >= 200 && r.statusCode < 300) {\n  outcome = 'ok'; result = (r.body && r.body.result) || null;\n} else if (r.statusCode >= 400 && r.statusCode < 500) {   // el back-office rechaza el contrato: no se reintenta\n  outcome = 'rejected'; error_code = (r.body && r.body.error) || 'rejected_by_backoffice';\n  message = JSON.stringify((r.body && (r.body.details || r.body.message)) || '');\n} else {                                          // 5xx: fallo técnico, se reintentará en el siguiente sondeo\n  outcome = 'error'; error_code = 'backoffice_error'; message = 'El back-office respondió HTTP ' + r.statusCode;\n}\nconst out = { source: ctx.source, event_id: ctx.event_id, event_type: ctx.event_type, cursor_id: ctx.cursor_id,\n  batch_next_cursor: ctx.batch_next_cursor, route: ctx.route, outcome, result, error_code, message };\nif (outcome === 'error') {\n  out.log_payload = { event_id: ctx.event_id, event_type: ctx.event_type, workflow: 'wf1-pedidos', execution_id: String($execution.id),\n    status: 'error', error_code, message, entity_type: 'order', entity_ref: ctx.event.payload.order_code };\n}\nreturn { json: out };",
        "mode": "runOnceForEachItem"
      },
