      "id": "7570d653-12ef-5696-86fe-0c562f43a350",
      "name": "Consultar pedido en la tienda",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "notes": "Herramienta de lectura: pedido completo normalizado.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Validar contrato').item.json;\nconst res = $input.item.json;\nconst code = ctx.event.payload.order_code;\nif (res.error || res.statusCode !== 200 || !res.body || !res.body.order) {\n  const notFound = res.statusCode === 404;\n  return { json: { ...ctx, prepared: false, outcome: notFound ? 'rejected' : 'error',\n    error_code: notFound ? 'order_not_found_in_shop' : 'shop_unavailable',\n    message: 'La tienda respondió ' + (res.statusCode ?? 'sin respuesta') + ' al consultar ' + code } };\n}\nconst o = res.body.order;\nconst c = o.customer || {};\n// Normalización: espacios fuera, email en minúsculas.\nconst bo = {\n  event_id: ctx.event_id, event_type: ctx.event_type, workflow: 'wf1-pedidos',\n  execution_id: String($execution.id), occurred_at: ctx.event.occurred_at,\n  order: { ...o, customer: {\n    full_name: String(c.full_name ?? '').trim(), email: String(c.email ?? '').trim().toLowerCase(),\n    city: c.city ?? null, province: c.province ?? null } },\n};\nreturn { json: { ...ctx, prepared: true, bo_payload: bo } };",
        "mode": "runOnceForEachItem"
      },
