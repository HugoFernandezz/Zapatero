      "id": "e751fe52-53ff-5967-8214-14f2b547e048",
      "name": "Procesar de uno en uno",
      "notes": "Un evento cada vez: así un fallo no impide registrar el resultado de los demás.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const it = $input.item.json;\nconst EVENT_ID = /^evt_[0-9a-f]{32}$/;\nconst ORDER_CODE = /^ZAP-\\d{8}-\\d{4}$/;\nconst STATUSES = ['created', 'paid_simulated', 'pending_preparation', 'shipped', 'incident', 'cancelled'];\nconst base = { source: it.source, batch_next_cursor: it.batch_next_cursor ?? null };\n\nif (it.noop) return { json: { ...base, route: 'noop', cursor_id: null, event_id: null, event_type: null } };\nif (it.auth_failed) {\n  return { json: { ...base, route: 'invalid', cursor_id: null, event_id: null, event_type: null,\n    error_code: 'unauthorized', errors: ['Webhook sin cabecera X-Webhook-Secret válida'] } };\n}\n\nconst e = it.event;\nconst errors = [];\nif (!e || typeof e !== 'object' || Array.isArray(e)) {\n  errors.push('El cuerpo no es un objeto JSON');\n} else {\n  if (!EVENT_ID.test(String(e.event_id ?? ''))) errors.push('event_id inválido (se espera evt_ + 32 hex)');\n  if (e.schema_version !== 1) errors.push('schema_version no soportada (se espera 1)');\n  if (!['order.created', 'order.status_changed'].includes(e.type)) errors.push('type no soportado: ' + e.type);\n  if (Number.isNaN(Date.parse(e.occurred_at))) errors.push('occurred_at no es una fecha ISO 8601');\n  const p = e.payload;\n  if (!p || typeof p !== 'object') {\n    errors.push('payload ausente');\n  } else {\n    if (!ORDER_CODE.test(String(p.order_code ?? ''))) errors.push('payload.order_code inválido (ZAP-AAAAMMDD-NNNN)');\n    if (e.type === 'order.created') {\n      if (!Number.isInteger(p.total_cents) || p.total_cents < 0) errors.push('payload.total_cents debe ser un entero >= 0');\n      if (!Number.isInteger(p.items) || p.items < 1) errors.push('payload.items debe ser un entero >= 1');\n    }\n    if (e.type === 'order.status_changed' && !STATUSES.includes(p.to)) errors.push('payload.to no es un estado válido');\n  }\n}\nconst meta = {\n  ...base, event: e ?? null, event_id: e?.event_id ?? null, event_type: e?.type ?? null,\n  cursor_id: Number.isInteger(e?.cursor_id) ? e.cursor_id : null,\n};\nif (errors.length) return { json: { ...meta, route: 'invalid', error_code: 'invalid_payload', errors } };\nreturn { json: { ...meta, route: e.type, errors: [] } };",
        "mode": "runOnceForEachItem"
      },
