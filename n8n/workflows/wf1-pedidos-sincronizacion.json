        "jsCode": "const c = $('Marcar rechazo').item.json;\nreturn { json: { source: c.source, event_id: c.event_id, event_type: c.event_type, cursor_id: c.cursor_id,\n  batch_next_cursor: c.batch_next_cursor, route: 'invalid', outcome: 'rejected', result: null,\n  error_code: c.error_code || 'invalid_payload', message: (c.errors || []).join('; ') } };",
