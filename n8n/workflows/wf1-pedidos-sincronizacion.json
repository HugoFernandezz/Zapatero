    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (res.statusCode !== 200) {\n  throw new Error('La API de eventos respondió HTTP ' + res.statusCode + ': ' + JSON.stringify(res.body ?? res.statusMessage ?? null));\n}\nconst body = res.body || {};\nconst events = Array.isArray(body.events) ? body.events : [];\nconst SUPPORTED = ['order.created', 'order.status_changed'];\nconst out = events\n  .filter(e => SUPPORTED.includes(e.type))\n  .map(e => ({ json: { source: 'poll', event: { ...e, cursor_id: e.cursor_id }, batch_next_cursor: body.next_after_id } }));\n// Hay eventos, pero ninguno es relevante para este flujo: se avanza el cursor igualmente.\nif (out.length === 0 && events.length > 0) {\n  return [{ json: { source: 'poll', noop: true, batch_next_cursor: body.next_after_id } }];\n}\nreturn out;"
      },
