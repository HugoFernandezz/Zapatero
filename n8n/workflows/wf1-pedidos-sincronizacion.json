      "name": "Resultado rechazo"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst count = o => items.filter(i => i.outcome === o).length;\nconst summary = {\n  processed: items.length, ok: count('ok'), rejected: count('rejected'), skipped: count('skipped'), errors: count('error'),\n  results: items.map(i => ({ event_id: i.event_id, type: i.event_type, outcome: i.outcome, result: i.result,\n    error_code: i.error_code, message: i.message })),\n};\nconst first = items[0] || {};\nif (first.source !== 'poll') return [{ json: { save: false, summary } }];\n\n// Cursor: se avanza hasta el final del lote, salvo que haya un error técnico (se reintentará desde ahí).\nlet next = first.batch_next_cursor;\nconst failed = items.filter(i => i.outcome === 'error' && Number.isInteger(i.cursor_id)).map(i => i.cursor_id).sort((a, b) => a - b);\nif (failed.length) next = failed[0] - 1;\nreturn [{ json: { save: Number.isInteger(next), cursor: String(next), summary } }];"
      },
