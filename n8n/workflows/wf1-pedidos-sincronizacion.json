    {
      "parameters": {
        "jsCode": "const res = $input.item.json;\nif (res.statusCode !== 200) {\n  throw new Error('No se pudo leer el cursor del back-office (HTTP ' + res.statusCode + '): ' + JSON.stringify(res.body ?? res.statusMessage ?? null));\n}\nconst raw = res.body && res.body.value;\nconst after = /^\\d+$/.test(String(raw ?? '')) ? Number(raw) : 0;\nreturn { json: { after_id: after } };",
        "mode": "runOnceForEachItem"
      },
