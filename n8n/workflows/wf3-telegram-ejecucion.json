      "id": "e37e8e50-5849-5f01-b67f-e5406420067d",
      "name": "Cada minuto (acciones)",
      "notes": "Flujo B: solo ejecuta propuestas que una persona haya APROBADO en /bo/agente.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "url": "={{ $env.BACKOFFICE_BASE_URL }}/bo/api/v1/agent-actions?status=approved",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.BO_API_TOKEN }}"
            }
          ]
