        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.reply) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        620
      ],
      "id": "1953b0a2-0a65-5c14-b4ac-59ed0ed24c13",
      "name": "Enviar mensaje al cliente",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "notes": "Acción sensible: solo llega aquí tras la aprobación humana registrada.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Preparar ejecución').item.json;\nconst r = $input.item.json;\nconst ok = r.statusCode === 200 && r.body && r.body.ok === true;\nconst report = ok ? { result: 'sent', note: 'Enviado por Telegram (message_id ' + (r.body.result && r.body.result.message_id) + ').' }\n  : { result: 'failed', note: 'Telegram no entregó el mensaje: ' + String((r.body && r.body.description) || r.statusCode || 'sin respuesta').slice(0, 150) };\nreturn { json: { action_id: prev.action_id, mode: 'telegram', report } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        620
      ],
      "id": "4f5a2d64-d6a7-590b-b6a6-eab5f50899aa",
      "name": "Informe del envío"
    },
    {
      "parameters": {
        "url": "={{ $env.BACKOFFICE_BASE_URL }}/bo/api/v1/agent-actions/{{ $json.action_id }}/executed",
        "options": {
