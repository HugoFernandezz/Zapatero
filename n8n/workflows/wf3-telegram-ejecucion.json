      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        700
      ],
      "id": "53dcd4f0-c5b3-5414-bd93-877608625614",
      "name": "Leer acciones aprobadas",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (res.statusCode !== 200) throw new Error('No se pudieron leer las acciones aprobadas (HTTP ' + res.statusCode + ')');\nconst actions = (res.body && res.body.actions) || [];\nreturn actions.map(a => ({ json: { action: a } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        700
      ],
      "id": "3ea17e74-2050-567e-9c28-35d2cc97a24a",
      "name": "Separar acciones"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        720,
        700
      ],
      "id": "f83c4ee8-2f6d-530f-aa36-7951b1681cdf",
      "name": "Una acción cada vez"
    },
    {
      "parameters": {
        "jsCode": "const a = $input.item.json.action;\nconst hasBot = !!String($env.TELEGRAM_BOT_TOKEN || '').trim();\nconst prefix = 'Zapatero (prototipo académico, sin actividad comercial real)';\nif (a.action_type === 'customer_message' && a.telegram_chat_id && hasBot) {\n  const text = prefix + '\\nPedido ' + a.order_code + ':\\n' + String(a.action.message || '').slice(0, 800);\n  return { json: { action_id: a.id, mode: 'telegram', reply: { chat_id: String(a.telegram_chat_id), text } } };\n}\nlet note;\nif (a.action_type === 'customer_message') note = 'Modo simulado: el cliente no tiene Telegram vinculado' + (hasBot ? '' : ' (o el bot no está configurado)') + '. Mensaje no enviado.';\nelse if (a.action_type === 'status_change_proposal') note = 'Modo simulado: cambio de estado propuesto a «' + a.action.new_status + '». Queda como tarea para aplicarlo manualmente en /admin.';\nelse if (a.action_type === 'internal_task') note = 'Modo simulado: tarea interna registrada: ' + String(a.action.task || '').slice(0, 200);\nelse note = 'Sin acción que ejecutar.';\nreturn { json: { action_id: a.id, mode: 'simulated', report: { result: 'simulated', note } } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        700
      ],
      "id": "d365710d-1216-590e-be77-fd264931de3b",
      "name": "Preparar ejecución",
      "notes": "Solo customer_message con chat vinculado se envía de verdad; el resto se ejecuta en modo simulado (reversible).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ed81852d-9fda-535d-8ffb-6b5c781142fc",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "telegram",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        700
      ],
      "id": "7ac8878b-18e9-5a12-b497-332cf1e5fee3",
      "name": "¿Enviar por Telegram?"
    },
