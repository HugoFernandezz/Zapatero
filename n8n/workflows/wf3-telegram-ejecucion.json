      "id": "7ab78d65-6afd-5386-8690-24c4dd5c0693",
      "name": "Leer offset de Telegram",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (!String($env.TELEGRAM_BOT_TOKEN || '').trim()) return [];     // sin bot configurado: el flujo no hace nada (ni falla)\nif (res.statusCode !== 200) throw new Error('No se pudo leer el offset de Telegram (HTTP ' + res.statusCode + ')');\nconst raw = res.body && res.body.value;\nreturn [{ json: { offset: /^\\d+$/.test(String(raw ?? '')) ? Number(raw) : 0 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "dc228754-7068-51e2-a6de-2471a8f4e77e",
      "name": "Preparar petición a Telegram"
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates?offset={{ $json.offset }}&timeout=0&allowed_updates=%5B%22message%22%5D",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "id": "2a4e1f92-f2d9-5a65-a551-c9c29136ea69",
      "name": "Pedir mensajes a Telegram",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (res.statusCode !== 200 || !res.body || res.body.ok !== true)\n  throw new Error('Telegram respondió HTTP ' + res.statusCode + ' (¿token del bot correcto?): ' + JSON.stringify((res.body && res.body.description) ?? null));\nconst updates = res.body.result || [];\nif (!updates.length) return [];\nconst next_offset = Math.max(...updates.map(u => u.update_id)) + 1;\nreturn updates.map(u => {\n  const m = u.message || {};\n  const text = String(m.text || '').trim();\n  const chat_id = m.chat && m.chat.id !== undefined ? String(m.chat.id) : null;\n  const priv = m.chat && m.chat.type === 'private';\n  const mm = text.match(/^\\/start(?:@\\w+)?\\s+([0-9a-f]{32})$/);  // token de un solo uso del enlace t.me\n  let kind = 'ignore';\n  if (chat_id && priv) kind = mm ? 'link' : (/^\\/(start|help)/i.test(text) ? 'help' : 'ignore');\n  return { json: { kind, chat_id, token: mm ? mm[1] : null, order_code: null, update_id: u.update_id, next_offset } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "id": "29841730-a5da-5bee-8223-4a87a84e2934",
      "name": "Extraer mensajes",
      "notes": "Solo chats privados. Calcula el siguiente offset para no releer mensajes.",
      "notesInFlow": true
    },
    {
