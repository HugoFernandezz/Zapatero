        1920,
        700
      ],
      "id": "c0d274c6-b3ac-5d10-9cea-045c4cb979d7",
      "name": "Informar ejecución al back-office",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "notes": "Cierra el ciclo: executed / executed_simulated / execution_failed.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Preparar ejecución').item.json;\nconst r = $input.item.json;\nreturn { json: { action_id: prev.action_id, mode: prev.mode, http: r.statusCode ?? null, final_status: r.body && r.body.status } };",
        "mode": "runOnceForEachItem"
      },
