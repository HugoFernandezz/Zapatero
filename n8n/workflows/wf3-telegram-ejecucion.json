      ],
      "id": "02606d98-4ec8-553e-9567-fb42c44a5c1f",
      "name": "Vincular chat en el back-office",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const m = $('Enrutar mensaje').item.json;\nconst r = $input.item.json;\nconst order = r.body && r.body.order_code ? r.body.order_code : null;\nlet text, linked = false;\nif (r.statusCode === 200) { linked = true; text = 'Listo: a partir de ahora recibirás por aquí los avisos del pedido ' + order + '.'; }\nelse if (r.statusCode === 409) text = 'Tu pedido aún se está sincronizando. Espera un minuto y vuelve a pulsar el botón de Telegram en la página de tu pedido.';\nelse if (r.statusCode === 410) text = 'Este enlace ya se usó o ha caducado. Pulsa de nuevo el botón de Telegram en la página de tu pedido para obtener uno nuevo.';\nelse if (r.statusCode === 404 || r.statusCode === 422) text = 'Este enlace no es válido. Pulsa el botón de Telegram en la página de tu pedido.';\nelse text = 'Ahora mismo no puedo vincular el pedido. Inténtalo de nuevo en unos minutos.';\n// El token no se arrastra a los nodos siguientes (ya es de un solo uso, pero no hace falta conservarlo).\nreturn { json: { ...m, token: null, order_code: order, linked, link_status: r.statusCode ?? null, reply: { chat_id: m.chat_id, text: 'Zapatero (prototipo académico, sin actividad comercial real)\\n' + text } } };\n",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -140
      ],
      "id": "36559f76-ce92-5042-9c33-6f0e3e7a29d6",
      "name": "Preparar respuesta de vinculación"
    },
    {
      "parameters": {
        "jsCode": "const m = $input.item.json;\nreturn { json: { ...m, token: null, linked: false, reply: { chat_id: m.chat_id,\n  text: 'Zapatero (prototipo académico, sin actividad comercial real)\\nPara recibir avisos de tu pedido, abre la página de tu pedido en la web de Zapatero y pulsa el botón «Recibir avisos por Telegram». El enlace es personal y de un solo uso.' } } };\n",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        80
      ],
      "id": "9c704ffa-48c3-5143-9a86-8c6815a5041a",
      "name": "Preparar ayuda"
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.reply) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        -40
      ],
      "id": "c5b09faf-aa76-593b-ac3d-4640b576d81e",
      "name": "Responder por Telegram",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Enrutar mensaje').item.json;\nconst r = $input.item.json;\nconst sent = r.statusCode === 200 && r.body && r.body.ok === true;\nreturn { json: { kind: prev.kind, order_code: prev.order_code, next_offset: prev.next_offset, sent } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -40
      ],
      "id": "a28532c8-f1c0-5451-81e8-c7a7929edad5",
      "name": "Resultado mensaje"
    },
    {
      "parameters": {
        "jsCode": "const m = $input.item.json;\nreturn { json: { kind: 'ignore', order_code: null, next_offset: m.next_offset, sent: false } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        260
      ],
      "id": "e13ba617-e088-5d00-b672-85a299d0cbb4",
      "name": "Resultado ignorado"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst next = Math.max(...items.map(i => i.next_offset).filter(Number.isInteger));\nreturn [{ json: { value: String(next), linked: items.filter(i => i.kind === 'link' && i.sent).length, total: items.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
