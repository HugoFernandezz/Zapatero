            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "c7155170-1b07-49cd-8524-170d38367c11",
      "name": "Resultado sin datos privados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        0
      ],
      "parameters": {
        "jsCode": "const salud = $('Salud pública').first().json.statusCode;\nconst backoffice = $input.first().json.statusCode;\nif (salud !== 200 || backoffice !== 200) throw new Error('No se ha validado la publicación');\nreturn [{json:{origen:'n8n alojado en Render (red externa al equipo local)',fecha_utc:new Date().toISOString(),tienda:'https://www.zapatero.onl/health',http_tienda:salud,backoffice:'https://www.zapatero.onl/bo/api/v1/metrics',http_backoffice:backoffice,resultado:'correcto',alcance:'Lectura HTTP y API autenticada; no ejecuta ventas, Telegram ni modelo IA'}}];"
      }
    }
  ],
