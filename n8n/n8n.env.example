# Copia este archivo a n8n.env y rellena los valores. n8n.env NO se sube a git (ver .gitignore).
# Solo valores de PRUEBA. Sin comillas ni comentarios en la misma línea.

# --- Modo local (la tienda corre en tu PC con `composer start:lan`) ---
ZAPATERO_BASE_URL=http://host.docker.internal:8000
BACKOFFICE_BASE_URL=http://host.docker.internal:8000

# --- Modo producción (la tienda y el back-office en tu dominio): sustituye por tu dominio, sin barra final ---
# ZAPATERO_BASE_URL=https://tu-dominio.example
# BACKOFFICE_BASE_URL=https://tu-dominio.example

# Mismo valor que API_TOKEN del .env de la tienda (lectura de eventos y pedidos)
ZAPATERO_API_TOKEN=
# Mismo valor que BO_API_TOKEN del .env de la tienda (escritura en el back-office)
BO_API_TOKEN=
# Secreto que debe enviar quien llame al webhook (cabecera X-Webhook-Secret). Genera uno nuevo.
N8N_WEBHOOK_SECRET=

# ===================== Fase 4-5: Telegram y agente de IA =====================
# Bot de Telegram (créalo con @BotFather). Si se deja vacío, el flujo de Telegram no hace nada y las acciones se ejecutan en modo simulado.
TELEGRAM_BOT_TOKEN=
# (Opcional) chat del personal para avisar de propuestas pendientes. Obtén tu id escribiendo al bot y abriendo
# https://api.telegram.org/bot<TOKEN>/getUpdates  (campo message.chat.id). Vacío = sin aviso.
TELEGRAM_ADMIN_CHAT_ID=

# Modelo de lenguaje con API compatible con OpenAI. Si falta algo de esto, el agente entra en MODO SEGURO
# (no llama a ningún modelo y deriva el ticket a revisión humana). Elige UNA opción y comprueba el nombre del modelo en su documentación:
#
# Opción A · Google Gemini (capa gratuita, clave en https://aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
#
# Opción B · Groq (capa gratuita)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# Opción C · Ollama en tu PC (100 % local y gratis, sin enviar datos a terceros)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
