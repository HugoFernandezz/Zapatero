{
    "name": "zapatero/tienda",
    "description": "Zapatero - prototipo académico de eCommerce (SIE, Tarea 1)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/php-view": "^3.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public"
        ],
        "db:init": "php database/init.php"
    }
}
