# Copiar a .env y ajustar. No subir nunca .env al repositorio.
APP_ENV=local
APP_DEBUG=true

# Ruta relativa a la raíz del proyecto
DB_PATH=storage/zapatero.sqlite

# --- Correo (factura del pedido) ---
# "log": no envía; guarda el correo como .eml en storage/mail (desarrollo local).
# "smtp": envía de verdad por un servidor SMTP (ver SMTP_* abajo). Sirve en local y en hosting.
# "mail": envía con mail() de PHP (solo si el hosting tiene el correo configurado).
MAIL_DRIVER=log
# En producción usa una dirección de TU dominio (si no, muchos servidores lo marcan como spam).
MAIL_FROM=tucuenta@gmail.com
MAIL_FROM_NAME=Zapatero

# --- Back-office (/admin/login) ---
# Administrador de PRUEBA: se crea solo en el primer acceso al login si no existe.
ADMIN_EMAIL=admin@zapatero.test
ADMIN_PASSWORD=cambia-esta-clave

# --- SMTP (solo si MAIL_DRIVER=smtp) ---
# Verificar certificado TLS (déjalo en true; pon false solo si en XAMPP/Windows falla con "certificate verify failed").
SMTP_VERIFY_PEER=true
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). MAIL_FROM debe ser la misma cuenta que SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# tls = STARTTLS (puerto 587) · ssl = SSL directo (puerto 465)
SMTP_SECURE=tls
SMTP_USER=tucuenta@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# --- API de eventos (/api/events) ---
# Si se define, hay que enviarlo en la cabecera X-Api-Token. En producción ponle un valor propio.
EVENTS_API_TOKEN=
